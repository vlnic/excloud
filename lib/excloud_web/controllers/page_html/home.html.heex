<Layouts.app flash={@flash}>
  <section
    id="welcome"
    class="app-hero row align-items-center g-5"
    aria-labelledby="welcome-title"
  >
    <div class="lg:col-7">
      <span class="app-eyebrow"><span class="app-status-dot" /> Your next idea starts here</span>
      <h1 id="welcome-title" class="app-hero-title">
        Peace of mind from prototype to production
      </h1>
      <p class="app-hero-description">
        A productive foundation for your next application. Build rich, real-time experiences with Phoenix and a thoughtfully styled Bootstrap interface.
      </p>
      <div class="d-flex flex-wrap gap-3 mt-5">
        <a
          id="welcome-get-started"
          href="https://phoenix.hexdocs.pm/overview.html"
          class="btn-solid theme-primary"
        >Start building <span aria-hidden="true">↗</span></a>
        <a
          id="welcome-bootstrap"
          href="https://getbootstrap.com/docs/6.0/getting-started/install/"
          class="btn-outline theme-secondary"
        >Explore Bootstrap</a>
      </div>
    </div>
    <div class="lg:col-5">
      <div class="app-hero-panel">
        <span class="app-panel-label">A fresh foundation</span>
        <.icon name="bootstrap" class="app-hero-logo" />
        <p class="app-panel-title">Make something great.</p>
        <p class="app-panel-description">The tools you need.<br />The space to make it yours.</p>
        <div class="app-panel-tags">
          <span>Phoenix</span><span>LiveView</span><span>Bootstrap 6</span>
        </div>
      </div>
    </div>
  </section>
  <section id="resources" class="app-resources" aria-labelledby="resources-title">
    <div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-4">
      <div>
        <span class="app-eyebrow">Find your way</span><h2
          id="resources-title"
          class="h4 fw-semibold mt-2 mb-0"
        >
          A little inspiration. A clear next step.
        </h2>
      </div>
      <span class="app-muted small">Everything you need to get going</span>
    </div>
    <div class="row g-4">
      <div class="md:col-4">
        <a
          id="resource-guides"
          href="https://phoenix.hexdocs.pm/overview.html"
          class="app-resource-card"
        >
          <span class="app-resource-number">01 / LEARN</span><h3 class="h5">
            Read the guides <span aria-hidden="true">↗</span>
          </h3><p>Get comfortable with Phoenix, from your first page to your next release.</p>
        </a>
      </div>
      <div class="md:col-4">
        <a
          id="resource-components"
          href="https://getbootstrap.com/docs/6.0/components/button/"
          class="app-resource-card"
        >
          <span class="app-resource-number">02 / CREATE</span><h3 class="h5">
            Explore components <span aria-hidden="true">↗</span>
          </h3><p>
            Bring your interface together with responsive layouts and reusable building blocks.
          </p>
        </a>
      </div>
      <div class="md:col-4">
        <a
          id="resource-community"
          href="https://elixirforum.com/c/phoenix-forum"
          class="app-resource-card"
        >
          <span class="app-resource-number">03 / CONNECT</span><h3 class="h5">
            Meet the community <span aria-hidden="true">↗</span>
          </h3><p>Ask a question, share an idea, and learn alongside other Phoenix developers.</p>
        </a>
      </div>
    </div>
  </section>
</Layouts.app>
