defmodule <%= inspect context.web_module %>.<%= inspect Module.concat(schema.web_namespace, schema.alias) %>RegistrationHTML do
  @moduledoc false

  use <%= inspect context.web_module %>, :html

  embed_templates "<%= schema.singular %>_registration_html/*", suffix: "_template"

  def new(assigns) do
    assigns = assign(assigns, :form, to_form(assigns.changeset))
    new_template(assigns)
  end
end
