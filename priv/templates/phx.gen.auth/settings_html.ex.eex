defmodule <%= inspect context.web_module %>.<%= inspect Module.concat(schema.web_namespace, schema.alias) %>SettingsHTML do
  @moduledoc false

  use <%= inspect context.web_module %>, :html

  embed_templates "<%= schema.singular %>_settings_html/*", suffix: "_template"

  def edit(assigns) do
    assigns =
      assigns
      |> assign(:email_form, to_form(assigns.email_changeset))
      |> assign(:password_form, to_form(assigns.password_changeset))

    edit_template(assigns)
  end
end
