// Phoenix packages resolve from Mix dependencies; npm packages resolve normally.
// Keep these aliases aligned with the NODE_PATH in config/config.exs.
{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "phoenix": ["../deps/phoenix"],
      "phoenix_html": ["../deps/phoenix_html"],
      "phoenix_live_view": ["../deps/phoenix_live_view"],
      "phoenix-colocated/*": ["../_build/dev/phoenix-colocated/*"]
    },
    "allowJs": true,
    "noEmit": true
  },
  "include": ["js/**/*"]
}
